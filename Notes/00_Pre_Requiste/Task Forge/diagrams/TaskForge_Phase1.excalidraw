    {
      "id": "el0106",
      "type": "text",
      "x": 2948.1633763450595,
      "y": 2370.7496730955527,
      "width": 550,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "T1AKL3S_td-0O30C-XuXz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1860849707,
      "version": 109,
      "versionNonce": 1266018492,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793610023165,
      "link": null,
      "locked": false,
      "text": "Why enforce it?\n• A buggy worker can't mark a CANCELLED job done\n• One place (JobTransitions) decides legality\n• Every change is also written to job_events\n  (full history, for debugging)\n• Rule: transition = UPDATE … WHERE status = <expected>",
      "originalText": "Why enforce it?\n• A buggy worker can't mark a CANCELLED job done\n• One place (JobTransitions) decides legality\n• Every change is also written to job_events\n  (full history, for debugging)\n• Rule: transition = UPDATE … WHERE status = <expected>",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 90,
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b2b"
    },
