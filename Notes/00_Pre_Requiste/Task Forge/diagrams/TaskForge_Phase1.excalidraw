      "isDeleted": false,
      "boundElements": [],
      "updated": 1793610040980,
      "link": null,
      "locked": false,
      "text": "Zombie case (fencing)\nWorker 1 wasn't dead, only PAUSED (GC pause, kill -STOP). It wakes up at t=60s and tries:\nUPDATE jobs SET status='SUCCEEDED' WHERE id=? AND locked_by='worker1'\n→ 0 rows (job now belongs to Worker 2) → Worker 1 discards its result.",
      "originalText": "Zombie case (fencing)\nWorker 1 wasn't dead, only PAUSED (GC pause, kill -STOP). It wakes up at t=60s and tries:\nUPDATE jobs SET status='SUCCEEDED' WHERE id=? AND locked_by='worker1'\n→ 0 rows (job now belongs to Worker 2) → Worker 1 discards its result.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 56,
      "containerId": null,
      "lineHeight": 1.25,
