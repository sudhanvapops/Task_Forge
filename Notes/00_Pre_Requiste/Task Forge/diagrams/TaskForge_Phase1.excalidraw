      "frameId": null,
      "roundness": null,
      "seed": 2109244315,
      "version": 21,
      "versionNonce": 170716476,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793610131252,
      "link": null,
      "locked": false,
      "text": "1. Two workers grab the same job\n    → FOR UPDATE SKIP LOCKED\n2. A worker dies mid-job (stuck forever)\n    → leases + heartbeats + reaper\n3. A job fails (retry storms)\n    → backoff + jitter + dead-letter queue\n4. Same request sent twice\n    → idempotency keys\n5. You can't see what's happening\n    → state machine + metrics",
      "originalText": "1. Two workers grab the same job\n    → FOR UPDATE SKIP LOCKED\n2. A worker dies mid-job (stuck forever)\n    → leases + heartbeats + reaper\n3. A job fails (retry storms)\n    → backoff + jitter + dead-letter queue\n4. Same request sent twice\n    → idempotency keys\n5. You can't see what's happening\n    → state machine + metrics",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
