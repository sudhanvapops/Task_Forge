      "frameId": null,
      "roundness": null,
      "seed": 1870675710,
      "version": 37,
      "versionNonce": 567597628,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793610040980,
      "link": null,
      "locked": false,
      "text": "Lease length trade-off\nShort lease = fast recovery, but risks stealing slow jobs.\nLong lease = slow recovery.\nHeartbeat gives both: short lease, kept alive while healthy.",
      "originalText": "Lease length trade-off\nShort lease = fast recovery, but risks stealing slow jobs.\nLong lease = slow recovery.\nHeartbeat gives both: short lease, kept alive while healthy.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 56,
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b3l"
    },
