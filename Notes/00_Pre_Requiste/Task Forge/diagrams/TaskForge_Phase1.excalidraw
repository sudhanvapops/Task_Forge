      "y": -187.12314067100908,
      "width": 600,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9bVcxmBKEb2vg0QPIOWyL",
        "xzWZ5OxXKq8rNOAFcjZOV"
