      "seed": 1038790516,
      "version": 109,
      "versionNonce": 749184956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793610023165,
      "link": null,
      "locked": false,
      "text": "ILLEGAL — must be rejected in code\n(and by a CHECK constraint)\n• SUCCEEDED → anything\n• CANCELLED → anything\n• QUEUED → SUCCEEDED (skipping RUNNING)\n• DEAD → RUNNING (only manual requeue → QUEUED)",
      "originalText": "ILLEGAL — must be rejected in code\n(and by a CHECK constraint)\n• SUCCEEDED → anything\n• CANCELLED → anything\n• QUEUED → SUCCEEDED (skipping RUNNING)\n• DEAD → RUNNING (only manual requeue → QUEUED)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 90,
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b2Z"
    },
    {
      "id": "el0105",
      "type": "rectangle",
      "x": 2933.1633763450595,
      "y": 2360.7496730955527,
      "width": 580,
      "height": 190,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
