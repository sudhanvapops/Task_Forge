    {
      "id": "el0104",
      "type": "text",
      "x": 2328.1633763450595,
      "y": 2370.7496730955527,
      "width": 530,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
